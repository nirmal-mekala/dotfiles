// src/lib/process.ts
var import_node_child_process = require("node:child_process");
async function runProcess(command, args, options) {
  const subprocess = (0, import_node_child_process.spawn)(command, [...args], {
    cwd: options.cwd,
    env: options.env
  });
  const stdoutChunks = [];
  const stderrChunks = [];
  subprocess.stdout.on("data", (chunk) => {
    stdoutChunks.push(chunk);
  });
  subprocess.stderr.on("data", (chunk) => {
    stderrChunks.push(chunk);
  });
  return await new Promise((resolve4, reject) => {
    subprocess.on("error", reject);
    subprocess.on("close", (exitCode) => {
      resolve4({
        stdout: Buffer.concat(stdoutChunks).toString("utf8"),
        stderr: Buffer.concat(stderrChunks).toString("utf8"),
        exitCode: exitCode ?? 1
      });
    });
  });
}

// src/lib/bootstrap.ts
async function runBootstrapScript(scriptPath, worktreePath2) {
  validateBootstrapScript(scriptPath);
  const result = await runProcess("bash", [scriptPath], {
    cwd: worktreePath2,
    env: process.env
  });
  if (result.exitCode === 0) {
    return {
      stdout: result.stdout,
      stderr: result.stderr
    };
  }
  const message = result.stderr.trim() || result.stdout.trim();
  throw new Error(message || `bootstrap exited with code ${result.exitCode}`);
}
function validateBootstrapScript(scriptPath) {
  let stats;
  try {
    stats = (0, import_node_fs.statSync)(scriptPath);
  } catch {
    throw new Error(`bootstrap script not found: ${scriptPath}`);
  }
  if (!stats.isFile()) {
    throw new Error(`bootstrap script not found: ${scriptPath}`);
  }
  try {
    (0, import_node_fs.accessSync)(scriptPath, import_node_fs.constants.X_OK);
  } catch {
    throw new Error(`bootstrap script is not executable: ${scriptPath}`);
  }
}

