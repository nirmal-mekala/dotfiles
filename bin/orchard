` : ""}${n2}
`;
      switch (this.state) {
        case "submit": {
          const r2 = t2 ? `${(0, import_node_util.styleText)("gray", S_BAR)}  ` : "", l = wrapTextWithPrefix(
            e.output,
            a2(this.options[this.cursor], "selected"),
