  block: unicodeOr("\u2588", "#")
};
var c = (e, a2) => e.includes(`
`) ? e.split(`
`).map((t2) => a2(t2)).join(`
`) : a2(e);
var select = (e) => {
  const a2 = (t2, d) => {
    const s = t2.label ?? String(t2.value);
    switch (d) {
      case "disabled":
        return `${(0, import_node_util.styleText)("gray", S_RADIO_INACTIVE)} ${c(s, (n2) => (0, import_node_util.styleText)("gray", n2))}${t2.hint ? ` ${(0, import_node_util.styleText)("dim", `(${t2.hint ?? "disabled"})`)}` : ""}`;
      case "selected":
