# --- Font ---
font-family = FiraCode Nerd Font Mono
font-size = 16
font-style-bold = Regular


# --- Keybindings ---
keybind = cmd+u=toggle_background_opacity


# --- Appearance ---
cursor-style = block
shell-integration-features = no-cursor
background-opacity = 0.8
background-blur = 90
window-padding-x = 3
window-padding-y = 3

# --- Colors ---
background = #222222
foreground = #d2d2d2

# Palette - The correct syntax is palette = index=color
palette = 0=#1c1c1c
palette = 8=#585858
palette = 1=#ff5faf
palette = 9=#ff5faf
palette = 2=#5faf5f
palette = 10=#5faf5f
palette = 3=#d7875f
palette = 11=#d7875f
palette = 4=#5fafd7
palette = 12=#5fafd7
palette = 5=#af87d7
palette = 13=#af87d7
palette = 6=#00afaf
palette = 14=#00afaf
palette = 7=#d0d0d0
palette = 15=#feffff
